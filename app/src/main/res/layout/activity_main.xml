<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mu_bg"
    android:orientation="vertical">

    <!-- ============================= top bar ============================= -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mu_toolbar_height"
        android:background="@color/mu_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_menu"
            style="@style/Widget.MarkUltra.IconButton"
            android:contentDescription="@string/cd_menu"
            android:src="@drawable/ic_menu"
            app:tint="@color/mu_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@string/untitled"
                android:textColor="@color/mu_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/file_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/saved"
                android:textColor="@color/mu_text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_undo"
            style="@style/Widget.MarkUltra.IconButton"
            android:contentDescription="@string/cd_undo"
            android:src="@drawable/ic_undo"
            app:tint="@color/mu_text" />

        <ImageButton
            android:id="@+id/btn_redo"
            style="@style/Widget.MarkUltra.IconButton"
            android:contentDescription="@string/cd_redo"
            android:src="@drawable/ic_redo"
            app:tint="@color/mu_text" />

        <ImageButton
            android:id="@+id/btn_find"
            style="@style/Widget.MarkUltra.IconButton"
            android:contentDescription="@string/cd_search"
            android:src="@drawable/ic_search"
            app:tint="@color/mu_text" />

        <ImageButton
            android:id="@+id/btn_save"
            style="@style/Widget.MarkUltra.IconButton"
            android:contentDescription="@string/cd_save"
            android:src="@drawable/ic_save"
            app:tint="@color/mu_text" />
    </LinearLayout>

    <!-- ============================= view tabs ============================= -->
    <LinearLayout
        android:id="@+id/tabs_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mu_tabs_height"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="@dimen/mu_space_s"
        android:background="@drawable/bg_tabs_container"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_edit"
            style="@style/Widget.MarkUltra.TabPill"
            android:text="@string/tab_edit" />

        <TextView
            android:id="@+id/tab_split"
            style="@style/Widget.MarkUltra.TabPill"
            android:text="@string/tab_split" />

        <TextView
            android:id="@+id/tab_preview"
            style="@style/Widget.MarkUltra.TabPill"
            android:text="@string/tab_preview" />
    </LinearLayout>

    <!-- ============================= panes ============================= -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pane_editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.markultra.editor.editor.CodeEditor
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|start"
                android:hint="@string/editor_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
                android:paddingStart="@dimen/mu_editor_padding"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/mu_editor_padding"
                android:paddingBottom="40dp"
                android:scrollbars="vertical"
                android:textColor="@color/mu_text"
                android:textColorHighlight="@color/mu_pill_selected"
                android:textColorHint="@color/mu_text_muted"
                android:textSize="16sp" />
        </FrameLayout>

        <View
            android:id="@+id/split_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mu_divider"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@color/mu_divider"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/pane_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/mu_surface"
            android:paddingStart="@dimen/mu_space_s"
            android:paddingEnd="@dimen/mu_space_s"
            android:paddingTop="@dimen/mu_space_xs">

            <!-- The rendered document sits on its own sheet, the way the page reads on
                 github.com: one inset, one rounded corner, no chrome of its own. -->
            <FrameLayout
                android:id="@+id/preview_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_page"
                android:clipToOutline="true">

                <WebView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <!-- Empty state: shown only when the document has no text at all. -->
                <LinearLayout
                    android:id="@+id/preview_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:alpha="0.55"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_preview_empty"
                        app:tint="@color/mu_text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/hint_empty_preview"
                        android:textColor="@color/mu_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/empty_preview_body"
                        android:textColor="@color/mu_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ============================= find bar ============================= -->
    <!-- No android:id here: an id on <include> replaces the root view's id,
         which would make findViewById(R.id.find_bar_root) return null. -->
    <include layout="@layout/view_find_bar" />

    <!-- ============================= format bar ============================= -->
    <View
        android:id="@+id/format_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mu_divider"
        android:background="@color/mu_divider" />

    <include layout="@layout/view_format_bar" />

    <!-- ============================= status bar ============================= -->
    <include layout="@layout/view_status_bar" />
</LinearLayout>
