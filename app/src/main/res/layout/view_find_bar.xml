<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/find_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_find_bar"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/find_query"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/mu_text"
            android:textColorHint="@color/mu_text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/find_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:singleLine="true"
            android:textColor="@color/mu_text_muted"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_find_prev"
            style="@style/Widget.MarkUltra.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/find_prev"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_up"
            app:tint="@color/mu_text" />

        <ImageButton
            android:id="@+id/btn_find_next"
            style="@style/Widget.MarkUltra.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/find_next"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/mu_text" />

        <ImageButton
            android:id="@+id/btn_find_close"
            style="@style/Widget.MarkUltra.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/cd_close"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="@color/mu_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/replace_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <EditText
            android:id="@+id/replace_query"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:hint="@string/replace_hint"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/mu_text"
            android:textColorHint="@color/mu_text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_replace_one"
            style="@style/Widget.MarkUltra.Chip"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="@string/find_replace" />

        <TextView
            android:id="@+id/btn_replace_all"
            style="@style/Widget.MarkUltra.Chip"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="@string/find_replace_all" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/toggle_case"
            style="@style/Widget.MarkUltra.Chip"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:text="@string/find_case"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/toggle_word"
            style="@style/Widget.MarkUltra.Chip"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:text="@string/find_word"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/toggle_regex"
            style="@style/Widget.MarkUltra.Chip"
            android:layout_height="28dp"
            android:text="@string/find_regex"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
