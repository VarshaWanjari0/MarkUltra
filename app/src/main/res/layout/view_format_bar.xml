<?xml version="1.0" encoding="utf-8"?>
<!--
  Scrollable quick-format bar. Actions are grouped by intent (text | blocks |
  insert | code) and separated by hairline dividers, so the strip reads as four
  small tool clusters instead of one long run of buttons. It scrolls
  horizontally only and never steals focus from the editor.
-->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/format_bar_scroll"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mu_format_bar_height"
    android:background="@color/mu_bg"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:fadingEdgeLength="24dp"
    android:overScrollMode="never"
    android:requiresFadingEdge="horizontal"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/format_bar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/fmt_bold"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_bold"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fmt_italic"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_italic"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/fmt_strike"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_strike" />

        <TextView
            android:id="@+id/fmt_heading"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_heading"
            android:textStyle="bold" />

        <View style="@style/Widget.MarkUltra.GroupDivider" />

        <TextView
            android:id="@+id/fmt_list"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_list" />

        <TextView
            android:id="@+id/fmt_ordered"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_ordered" />

        <TextView
            android:id="@+id/fmt_task"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_task" />

        <TextView
            android:id="@+id/fmt_quote"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_quote" />

        <View style="@style/Widget.MarkUltra.GroupDivider" />

        <TextView
            android:id="@+id/fmt_table"
            style="@style/Widget.MarkUltra.Chip.Code"
            android:text="@string/fmt_table" />

        <TextView
            android:id="@+id/fmt_link"
            style="@style/Widget.MarkUltra.Chip.Code"
            android:text="@string/fmt_link" />

        <TextView
            android:id="@+id/fmt_image"
            style="@style/Widget.MarkUltra.Chip.Code"
            android:text="@string/fmt_image" />

        <View style="@style/Widget.MarkUltra.GroupDivider" />

        <TextView
            android:id="@+id/fmt_code"
            style="@style/Widget.MarkUltra.Chip.Code"
            android:text="@string/fmt_code" />

        <TextView
            android:id="@+id/fmt_codeblock"
            style="@style/Widget.MarkUltra.Chip.Code"
            android:text="@string/fmt_codeblock" />

        <TextView
            android:id="@+id/fmt_hr"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_hr" />

        <TextView
            android:id="@+id/fmt_footnote"
            style="@style/Widget.MarkUltra.Chip"
            android:text="@string/fmt_footnote" />

        <View style="@style/Widget.MarkUltra.GroupDivider" />

        <TextView
            android:id="@+id/fmt_more"
            style="@style/Widget.MarkUltra.Chip.Icon"
            android:contentDescription="@string/cd_more_formatting"
            android:text="@string/fmt_more" />
    </LinearLayout>
</HorizontalScrollView>
