<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/prompt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mu_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/prompt_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/mu_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/prompt_label1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/mu_text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/prompt_input1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip"
        android:inputType="text"
        android:minHeight="46dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textColor="@color/mu_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/prompt_label2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/mu_text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/prompt_input2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip"
        android:inputType="textUri"
        android:minHeight="46dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textColor="@color/mu_text"
        android:textSize="15sp" />
</LinearLayout>
