<?xml version="1.0" encoding="utf-8"?>
<!-- The sheet the rendered Markdown lives on. Rounded on all four corners and
     outlined with a hairline so it reads as a page even when the theme colours
     are close together. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/mu_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/mu_divider" />
    <corners android:radius="14dp" />
</shape>
